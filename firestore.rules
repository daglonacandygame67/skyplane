rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // positions, stats, market and airports are written only by the server functions (Admin SDK bypasses rules)
    match /world/{doc} { allow read: if request.auth != null; allow write: if false; }

    // who is in the voice room right now (heartbeat every 15 s)
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // WebRTC signalling: anyone signed in can drop a message in your inbox, only you can read/delete it
    match /signals/{uid}/msgs/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }

    // direct messages: conversation id is "<uuidA>_<uuidB>" (sorted); only the two members can use it
    match /dms/{conv}/messages/{id} {
      allow read: if request.auth != null && conv.split('_').hasAny([request.auth.uid]);
      allow create: if request.auth != null && conv.split('_').hasAny([request.auth.uid])
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.text is string && request.resource.data.text.size() <= 500;
    }

    // conversation list: inbox/<owner>/threads/<other>. The owner reads it; the owner or the other person
    // (when sending a message) may write that one thread.
    match /inbox/{owner}/threads/{other} {
      allow read: if request.auth != null && request.auth.uid == owner;
      allow write: if request.auth != null && (request.auth.uid == owner || request.auth.uid == other);
    }

    // copies of website messages for the receiver's in-game phone; only the server function reads them
    match /notify/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
                    && request.resource.data.text is string && request.resource.data.text.size() <= 500;
    }
  }
}
